---
import { siteConfig } from "../config";
const { faqs } = siteConfig;
---

<section id="faq" class="p-8 sm:p-12 md:p-16 lg:p-24 bg-white">
  <div>
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16 items-start">
      <div class="lg:col-span-4">
        <h2 class="text-3xl sm:text-4xl md:text-5xl xl:text-7xl font-bold text-gray-900">
          FAQ
        </h2>
        <div
          class="w-[75px] h-[5px] mt-2 rounded-full"
          style={`background-color: ${siteConfig.accentColor}`}
        />
        <p class="mt-6 text-lg text-gray-600">
          Quick answers to common questions about my expertise and availability.
        </p>
      </div>

      <div class="lg:col-span-8">
        <div class="space-y-8">
          {faqs.map((faq) => (
            <div class="border-b border-gray-200 pb-8 last:border-0 last:pb-0">
              <h3 class="text-xl sm:text-2xl font-bold text-gray-900 mb-4">
                {faq.question}
              </h3>
              <p class="text-lg sm:text-xl text-gray-600 leading-relaxed">
                {faq.answer}
              </p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
